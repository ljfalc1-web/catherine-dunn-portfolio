# Google Sheets CMS Configuration
# Get these from Google Cloud Console after creating a Service Account

# The email address of your Google Service Account
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from your Service Account JSON (keep the quotes, include \n for newlines)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheets URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here
